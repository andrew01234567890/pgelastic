{
  "title": "pgelastic",
  "uid": "pgelastic-overview",
  "description": "Every panel here queries a metric the tree actually emits. Panels for metrics nobody produces are how a dashboard becomes another false promise, so there are none.",
  "tags": [
    "pgelastic",
    "postgresql"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(pgelastic_metering_pool_connections, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {}
      },
      {
        "name": "kind",
        "type": "custom",
        "label": "Transition kind",
        "query": "PgTenantMigration,PgRestore,PgBackup",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Transitions - what this pool is moving right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "In flight",
      "description": "One series per phase, so a phase being left drives its series to zero rather than vanishing - a gap here means the operator stopped scraping, not that the work finished. Every series is dropped when the transition reaches a terminal phase, which is the only reason a per-object label is affordable at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pgelastic_transition_phase{namespace=~\"$namespace\", kind=~\"$kind\"} > 0",
          "legendFormat": "{{kind}}/{{name}} - {{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "auto",
        "rowHeight": 0.85,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Where each one is going",
      "description": "The route is its own series rather than two more labels on the phase gauge: putting them there would multiply eleven phases by every pair of instances. Joined here by the object's own name.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pgelastic_transition_route{namespace=~\"$namespace\", kind=~\"$kind\"}",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - pgelastic_transition_phase_since_seconds{namespace=~\"$namespace\", kind=~\"$kind\"}",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "Value #A": true,
              "job": true,
              "instance": true,
              "kind 2": true,
              "namespace 2": true
            },
            "renameByName": {
              "kind 1": "kind",
              "namespace 1": "namespace",
              "from": "leaving",
              "to": "joining",
              "Value #B": "age"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Completed, by outcome",
      "description": "The counter outlives the per-object series, which is what makes a rate possible at all - it cannot be computed from gauges that are deliberately deleted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind, to) (rate(pgelastic_transitions_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} -> {{to}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "How long they took (p50 / p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, kind) (rate(pgelastic_transition_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{kind}} p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(pgelastic_transition_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{kind}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tenant cutover pause",
      "description": "The product commitment: a p99 below one second with clients queued and never dropped. Online and offline are separate series because the offline pause is tens of seconds by design and averaging the two would hide both.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, strategy) (rate(pgelastic_migration_pause_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{strategy}} p99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Availability",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Split brain",
      "description": "Two members simultaneously reporting pg_is_in_recovery() = false. Page on this.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(pgelastic_split_brain_observed{namespace=~\"$namespace\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "index": 0
                },
                "1": {
                  "text": "SPLIT BRAIN",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Writes stalled",
      "description": "Fewer standbys streaming than the loaded synchronous_standby_names waits for. Writes are blocking.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(pgelastic_write_stalled{namespace=~\"$namespace\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Failover phase",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 8,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pgelastic_failover_phase{namespace=~\"$namespace\"} > 0",
          "legendFormat": "{{instance}} - {{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "What is holding a failover back",
      "description": "Each named veto is a label value rather than a metric of its own, so an alert can fire on 'a failover is being held back' without enumerating the reasons.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance, veto) (pgelastic_failover_veto{namespace=~\"$namespace\"})",
          "legendFormat": "{{instance}} - {{veto}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Quorum reachable voters",
      "description": "R in the R + W > N failover gate, as last evaluated.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pgelastic_failover_quorum_reachable_voters{namespace=~\"$namespace\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Capacity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Pool connections",
      "description": "in_use against allocatable is the fraction the autoscaler acts on. It read zero for the life of the product until status.capacity.inUse got a producer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, statistic) (pgelastic_metering_pool_connections{namespace=~\"$namespace\"})",
          "legendFormat": "{{pool}} - {{statistic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Tenants observed",
      "description": "Series count is here deliberately: this exposition is labelled by a closed enum and by nothing else precisely so that ~200 tenants per pool cannot turn 32 series into 6,400. This panel is how you notice if that ever stops being true.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool) (pgelastic_metering_tenants{namespace=~\"$namespace\"})",
          "legendFormat": "{{pool}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool) (pgelastic_metering_tenant_series{namespace=~\"$namespace\"})",
          "legendFormat": "{{pool}} series",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Metering staleness",
      "description": "The brake. A plan computed from stale samples is worse than no plan, and a store being fed zeros looks healthy without this.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pool) (pgelastic_metering_stale{namespace=~\"$namespace\"})",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Sample rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 45
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool) (rate(pgelastic_metering_samples_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Migration orphans swept",
      "description": "An abandoned slot pins the source primary's WAL until max_slot_wal_keep_size invalidates it, so a non-zero rate is evidence of migrations dying without running their own cleanup ladder.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 45
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (rate(pgelastic_migration_orphans_swept_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 28,
      "type": "row",
      "title": "Tenant workload - what the pool's databases are doing",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      },
      "panels": []
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Transactions",
      "description": "pg_stat_database's commit and rollback counters, summed over the pool's tenants. The rollback share is the number worth watching: a pool whose rollbacks climb is usually one tenant retrying against a lock or a constraint, and it costs the whole pool's backends.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, stat) (rate(pgelastic_metering_database_stats_total{namespace=~\"$namespace\", stat=~\"xact_commit|xact_rollback\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} - {{stat}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Buffer cache hit ratio",
      "description": "blks_hit over blks_hit + blks_read. A pool that falls away from 1 is reading from disk for work it used to serve from shared_buffers, which is the first thing a tenant that has outgrown its instance does.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool) (rate(pgelastic_metering_database_stats_total{namespace=~\"$namespace\", stat=\"blks_hit\"}[$__rate_interval])) / clamp_min(sum by (pool) (rate(pgelastic_metering_database_stats_total{namespace=~\"$namespace\", stat=~\"blks_hit|blks_read\"}[$__rate_interval])), 1)",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Proxy",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 59
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Client connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 60
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pgelastic_proxy_client_connections",
          "legendFormat": "held",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(pgelastic_proxy_client_connections_accepted_total[$__rate_interval])",
          "legendFormat": "accepted/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(pgelastic_proxy_client_connections_rejected_total[$__rate_interval])",
          "legendFormat": "rejected/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Backends held against budget",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 60
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pgelastic_proxy_backend_connections",
          "legendFormat": "in use",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pgelastic_proxy_backend_budget",
          "legendFormat": "budget",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pgelastic_proxy_backend_elastic_connections",
          "legendFormat": "elastic",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pgelastic_proxy_backend_elastic_limit",
          "legendFormat": "elastic limit",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Admission",
      "description": "The queue wait is the whole point of the capacity model and the number nobody could see.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 67
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
