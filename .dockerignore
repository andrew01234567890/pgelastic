# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include the Rust workspace, which Dockerfile.proxy builds from. The test
# sources come with it: cargo resolves the whole workspace before it builds any
# target, and a crate whose tests reference a missing file does not resolve.
!Cargo.toml
!Cargo.lock
!crates/**
