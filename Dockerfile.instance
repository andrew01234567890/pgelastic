# The instance manager image exists only to be copied out of.
#
# An init container mounts an emptyDir, runs `cp /pgelastic-instance /agent/...` and
# nothing else. Keeping the agent out of the PostgreSQL image is what lets it be upgraded
# without rebuilding or re-certifying the database image, and keeping the init container
# down to one cp is what stops that indirection growing logic of its own.
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY . .

# CGO is off so the binary is static: it runs inside the PostgreSQL image, which shares
# none of this builder's libraries.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -o pgelastic-instance ./cmd/instance

# The durability oracle travels in the same image for the same reason the agent does: it
# has to run inside the cluster, against the read-write Service, so that a failover moves
# the endpoint underneath it the way it moves underneath a tenant.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -o pgelastic-verify ./cmd/verify

FROM busybox:1.37
COPY --from=builder /workspace/pgelastic-instance /pgelastic-instance
COPY --from=builder /workspace/pgelastic-verify /pgelastic-verify
USER 65532:65532
ENTRYPOINT ["/pgelastic-instance"]
